{
  "name": "polishup-cli",
  "version": "0.3.0",
  "description": "An AI agent skill for writing, design, code, and more. It combines task-specific research and practical guidance to create, refine, and review work while reducing generic AI output.",
  "author": "fachriaziz",
  "homepage": "https://github.com/fachriaziz/polishup#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fachriaziz/polishup.git"
  },
  "bugs": {
    "url": "https://github.com/fachriaziz/polishup/issues"
  },
  "keywords": [
    "agent-skills",
    "ai-agents",
    "writing",
    "ui-ux",
    "code-quality"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "polishup": "cli/index.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "skills/polishup/SKILL.md",
    "skills/polishup/LICENSE.txt",
    "skills/polishup/agents/",
    "skills/polishup/references/",
    "skills/polishup/scripts/",
    ".opencode/commands/polishup.md",
    "plugin.json",
    ".codex-plugin/plugin.json",
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    ".antigravity-plugin/plugin.json",
    ".agents/plugins/marketplace.json",
    "cli/index.mjs",
    "cli/hosts.mjs",
    "cli/detection.mjs",
    "cli/menu.mjs",
    "cli/prompts.mjs",
    "cli/plugins.mjs",
    "cli/installations.mjs",
    "cli/update.mjs"
  ],
  "scripts": {
    "start": "node cli/index.mjs",
    "test": "npm run check && node --test tests/*.test.mjs",
    "sync": "node scripts/prepare-tools.mjs && node scripts/export-native.mjs",
    "check": "node scripts/prepare-tools.mjs --check && node scripts/export-native.mjs --check"
  },
  "devDependencies": {
    "colorjs.io": "0.7.1",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@clack/core": "1.6.0",
    "@clack/prompts": "1.9.0"
  }
}
